# EUDIPLO backend (no trailing slash)
EUDIPLO_URL=https://eudiplo.playground.open-elements.cloud
# Least-privilege app client of the the-pearls tenant:
# presentation:request + issuance:offer, presentations guest-pid and booking-check
EUDIPLO_CLIENT_ID=the-pearls-app
EUDIPLO_CLIENT_SECRET=
GUEST_PRESENTATION_ID=guest-pid
BOOKING_PRESENTATION_ID=booking-check
BOOKING_CREDENTIAL_ID=booking
# Public URL of this site (no trailing slash); https:// enables secure cookies
APP_URL=http://localhost:3002
# Dates (arrival, departure, "today") are evaluated in this time zone
HOTEL_TIMEZONE=Europe/Rome
